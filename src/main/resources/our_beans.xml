<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="student" class="com.own.eosp.model.Student" scope="singleton">
<!--        <constructor-arg name="name" value="John Doe"/>-->
        <constructor-arg name="name" ref="studen_name"/>
        <constructor-arg name="address" ref="Add" />
    </bean>


    <bean id="studen_name" class="java.lang.String">
        <constructor-arg value="Jobaer"/>
    </bean>


    <bean id="Add" class="com.own.eosp.model.Address">

    </bean>
</beans>